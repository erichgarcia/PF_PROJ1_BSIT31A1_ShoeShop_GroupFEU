@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActivePage"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0 text-gray-800">Dashboard</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="#">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
            </ol>
        </nav>
    </div>
    <div class="text-muted">
        <i class="fas fa-calendar-alt me-2"></i>
        @DateTime.Now.ToString("MMMM dd, yyyy")
    </div>
</div>

<!-- Key Metrics Row -->
<div class="row mb-4">
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card metric-card">
            <div class="d-flex align-items-center">
                <div class="metric-icon" style="background-color: var(--primary-color);">
                    <i class="fas fa-shoe-prints"></i>
                </div>
                <div class="ms-3">
                    <div class="metric-label">Total Shoes</div>
                    <div class="metric-value">1,247</div>
                    <div class="text-success small">
                        <i class="fas fa-arrow-up me-1"></i>12% from last month
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card metric-card">
            <div class="d-flex align-items-center">
                <div class="metric-icon" style="background-color: var(--success-color);">
                    <i class="fas fa-dollar-sign"></i>
                </div>
                <div class="ms-3">
                    <div class="metric-label">Total Value</div>
                    <div class="metric-value">₱2.4M</div>
                    <div class="text-success small">
                        <i class="fas fa-arrow-up me-1"></i>8% from last month
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card metric-card">
            <div class="d-flex align-items-center">
                <div class="metric-icon" style="background-color: var(--warning-color);">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <div class="ms-3">
                    <div class="metric-label">Low Stock</div>
                    <div class="metric-value">24</div>
                    <div class="text-warning small">
                        <i class="fas fa-arrow-up me-1"></i>Needs attention
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card metric-card">
            <div class="d-flex align-items-center">
                <div class="metric-icon" style="background-color: var(--danger-color);">
                    <i class="fas fa-times-circle"></i>
                </div>
                <div class="ms-3">
                    <div class="metric-label">Out of Stock</div>
                    <div class="metric-value">7</div>
                    <div class="text-danger small">
                        <i class="fas fa-arrow-down me-1"></i>Urgent
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Recent Activity -->
    <div class="col-lg-8 mb-4">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0 font-weight-bold text-primary">Recent Inventory Activity</h6>
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        Last 7 days
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#">Last 24 hours</a></li>
                        <li><a class="dropdown-item" href="#">Last 7 days</a></li>
                        <li><a class="dropdown-item" href="#">Last 30 days</a></li>
                    </ul>
                </div>
            </div>
            <div class="card-body">
                <div class="activity-item d-flex align-items-center">
                    <div class="activity-icon bg-success text-white me-3">
                        <i class="fas fa-plus"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="fw-medium">Stock Added</div>
                        <small class="text-muted">Nike Air Force 1 - 50 units added to inventory</small>
                    </div>
                    <small class="text-muted">2 hours ago</small>
                </div>
                
                <div class="activity-item d-flex align-items-center">
                    <div class="activity-icon bg-info text-white me-3">
                        <i class="fas fa-edit"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="fw-medium">Price Updated</div>
                        <small class="text-muted">Adidas Ultraboost - Price changed from ₱8,500 to ₱7,999</small>
                    </div>
                    <small class="text-muted">4 hours ago</small>
                </div>
                
                <div class="activity-item d-flex align-items-center">
                    <div class="activity-icon bg-warning text-white me-3">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="fw-medium">Low Stock Alert</div>
                        <small class="text-muted">Converse Chuck Taylor - Only 5 units remaining</small>
                    </div>
                    <small class="text-muted">6 hours ago</small>
                </div>
                
                <div class="activity-item d-flex align-items-center">
                    <div class="activity-icon bg-primary text-white me-3">
                        <i class="fas fa-box"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="fw-medium">New Product Added</div>
                        <small class="text-muted">Puma RS-X - Added to catalog with 25 units</small>
                    </div>
                    <small class="text-muted">1 day ago</small>
                </div>
                
                <div class="activity-item d-flex align-items-center">
                    <div class="activity-icon bg-danger text-white me-3">
                        <i class="fas fa-minus"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="fw-medium">Stock Reduced</div>
                        <small class="text-muted">Vans Old Skool - 15 units sold</small>
                    </div>
                    <small class="text-muted">1 day ago</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions & Stock Alerts -->
    <div class="col-lg-4 mb-4">
        <!-- Quick Actions -->
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0 font-weight-bold text-primary">Quick Actions</h6>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="/Inventory/Create" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Add New Shoe
                    </a>
                    <a href="/Inventory/Import" class="btn btn-success">
                        <i class="fas fa-file-import me-2"></i>Import Inventory
                    </a>
                    <a href="/Reports" class="btn btn-info">
                        <i class="fas fa-chart-bar me-2"></i>View Reports
                    </a>
                    <a href="/Inventory/StockCheck" class="btn btn-warning">
                        <i class="fas fa-search me-2"></i>Stock Check
                    </a>
                </div>
            </div>
        </div>

        <!-- Stock Alerts -->
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0 font-weight-bold text-primary">Stock Alerts</h6>
            </div>
            <div class="card-body">
                <div class="alert alert-warning mb-2" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <div class="flex-grow-1">
                            <strong>Converse Chuck Taylor</strong><br>
                            <small>Only 5 units left</small>
                        </div>
                        <span class="badge badge-warning">Low</span>
                    </div>
                </div>
                
                <div class="alert alert-warning mb-2" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <div class="flex-grow-1">
                            <strong>Reebok Classic</strong><br>
                            <small>Only 8 units left</small>
                        </div>
                        <span class="badge badge-warning">Low</span>
                    </div>
                </div>
                
                <div class="alert alert-danger mb-2" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-times-circle me-2"></i>
                        <div class="flex-grow-1">
                            <strong>New Balance 990</strong><br>
                            <small>Out of stock</small>
                        </div>
                        <span class="badge badge-danger">Out</span>
                    </div>
                </div>
                
                <div class="alert alert-danger mb-0" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-times-circle me-2"></i>
                        <div class="flex-grow-1">
                            <strong>Jordan 1 Retro</strong><br>
                            <small>Out of stock</small>
                        </div>
                        <span class="badge badge-danger">Out</span>
                    </div>
                </div>
                
                <div class="mt-3">
                    <a href="/Inventory/StockAlerts" class="btn btn-sm btn-outline-primary w-100">
                        View All Alerts
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Top Categories -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0 font-weight-bold text-primary">Top Categories by Stock Value</h6>
                <a href="/Reports/Categories" class="btn btn-sm btn-outline-primary">View Details</a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Category</th>
                                <th>Total Units</th>
                                <th>Total Value</th>
                                <th>Top Brand</th>
                                <th>Stock Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-running text-primary me-2"></i>
                                        <strong>Running Shoes</strong>
                                    </div>
                                </td>
                                <td>487</td>
                                <td class="fw-bold text-success">₱1,245,000</td>
                                <td>Nike</td>
                                <td><span class="badge badge-success">Good</span></td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-basketball-ball text-warning me-2"></i>
                                        <strong>Basketball Shoes</strong>
                                    </div>
                                </td>
                                <td>312</td>
                                <td class="fw-bold text-success">₱892,000</td>
                                <td>Jordan</td>
                                <td><span class="badge badge-warning">Low</span></td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-walking text-info me-2"></i>
                                        <strong>Casual Shoes</strong>
                                    </div>
                                </td>
                                <td>234</td>
                                <td class="fw-bold text-success">₱345,000</td>
                                <td>Adidas</td>
                                <td><span class="badge badge-success">Good</span></td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-shoe-prints text-secondary me-2"></i>
                                        <strong>Lifestyle</strong>
                                    </div>
                                </td>
                                <td>214</td>
                                <td class="fw-bold text-success">₱287,000</td>
                                <td>Converse</td>
                                <td><span class="badge badge-success">Good</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
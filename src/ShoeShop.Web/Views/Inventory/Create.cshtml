@model ShoeShop.Services.DTOs.Simple.SimpleShoeCreateDto
@{
    ViewData["Title"] = "Add New Shoe";
    ViewData["ActivePage"] = "Inventory";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0 text-gray-800">Add New Shoe</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/Home/Dashboard">Home</a></li>
                <li class="breadcrumb-item"><a href="/Inventory">Inventory</a></li>
                <li class="breadcrumb-item active" aria-current="page">Add New</li>
            </ol>
        </nav>
    </div>
    <div>
        <a href="/Inventory" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-plus me-2"></i>Shoe Information</h5>
            </div>
            <div class="card-body">
                <form method="post" class="needs-validation" novalidate>
                    @Html.AntiForgeryToken()
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Name" class="form-label">Shoe Name *</label>
                                <input asp-for="Name" class="form-control" required>
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            
                            <div class="mb-3">
                                <label asp-for="Brand" class="form-label">Brand *</label>
                                <select asp-for="Brand" class="form-select" required>
                                    <option value="">Select Brand</option>
                                    @foreach (var brand in ViewBag.Brands as List<string>)
                                    {
                                        <option value="@brand">@brand</option>
                                    }
                                </select>
                                <span asp-validation-for="Brand" class="text-danger"></span>
                            </div>
                            
                            <div class="mb-3">
                                <label asp-for="Category" class="form-label">Category *</label>
                                <select asp-for="Category" class="form-select" required>
                                    <option value="">Select Category</option>
                                    @foreach (var category in ViewBag.Categories as List<string>)
                                    {
                                        <option value="@category">@category</option>
                                    }
                                </select>
                                <span asp-validation-for="Category" class="text-danger"></span>
                            </div>
                            
                            <div class="mb-3">
                                <label asp-for="Size" class="form-label">Size *</label>
                                <select asp-for="Size" class="form-select" required>
                                    <option value="">Select Size</option>
                                    @foreach (var size in ViewBag.Sizes as List<string>)
                                    {
                                        <option value="@size">@size</option>
                                    }
                                </select>
                                <span asp-validation-for="Size" class="text-danger"></span>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Color" class="form-label">Color *</label>
                                <input asp-for="Color" class="form-control" required>
                                <span asp-validation-for="Color" class="text-danger"></span>
                            </div>
                            
                            <div class="mb-3">
                                <label asp-for="Price" class="form-label">Price (₱) *</label>
                                <div class="input-group">
                                    <span class="input-group-text">₱</span>
                                    <input asp-for="Price" type="number" step="0.01" min="0" class="form-control currency" required>
                                </div>
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>
                            
                            <div class="mb-3">
                                <label asp-for="StockQuantity" class="form-label">Initial Stock Quantity *</label>
                                <input asp-for="StockQuantity" type="number" min="0" class="form-control" required>
                                <span asp-validation-for="StockQuantity" class="text-danger"></span>
                            </div>
                            
                            <div class="mb-3">
                                <label asp-for="SKU" class="form-label">SKU *</label>
                                <input asp-for="SKU" class="form-control font-monospace" required placeholder="e.g. NK-AF1-001">
                                <div class="form-text">Unique product identifier</div>
                                <span asp-validation-for="SKU" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Optional product description"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    
                    <hr>
                    
                    <div class="d-flex justify-content-between">
                        <button type="button" class="btn btn-secondary" onclick="history.back()">
                            <i class="fas fa-times me-2"></i>Cancel
                        </button>
                        <button type="submit" class="btn btn-success" data-loading-text="Creating...">
                            <i class="fas fa-save me-2"></i>Create Shoe
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-lg-4">
        <!-- Help Card -->
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0"><i class="fas fa-info-circle me-2"></i>Tips</h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <strong>SKU Format:</strong>
                    <p class="small text-muted">Use format: BRAND-MODEL-ID<br>
                    Example: NK-AF1-001 for Nike Air Force 1</p>
                </div>
                
                <div class="mb-3">
                    <strong>Pricing:</strong>
                    <p class="small text-muted">Enter the retail price in Philippine Peso (₱)</p>
                </div>
                
                <div class="mb-0">
                    <strong>Stock:</strong>
                    <p class="small text-muted">Initial quantity for this shoe variant</p>
                </div>
            </div>
        </div>
        
        <!-- Preview Card -->
        <div class="card mt-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="fas fa-eye me-2"></i>Quick Preview</h6>
            </div>
            <div class="card-body">
                <div class="text-muted small">
                    Fill out the form to see a preview of your shoe entry.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        // Auto-generate SKU based on brand and name
        document.getElementById('Brand').addEventListener('change', generateSKU);
        document.getElementById('Name').addEventListener('input', generateSKU);
        
        function generateSKU() {
            const brand = document.getElementById('Brand').value;
            const name = document.getElementById('Name').value;
            
            if (brand && name) {
                const brandCode = brand.substring(0, 2).toUpperCase();
                const nameCode = name.replace(/\s+/g, '').substring(0, 3).toUpperCase();
                const randomNum = Math.floor(Math.random() * 999) + 1;
                const sku = `${brandCode}-${nameCode}-${randomNum.toString().padStart(3, '0')}`;
                
                document.getElementById('SKU').value = sku;
            }
        }
        
        // Form validation
        (function() {
            'use strict';
            window.addEventListener('load', function() {
                var forms = document.getElementsByClassName('needs-validation');
                var validation = Array.prototype.filter.call(forms, function(form) {
                    form.addEventListener('submit', function(event) {
                        if (form.checkValidity() === false) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
            }, false);
        })();
    </script>
}
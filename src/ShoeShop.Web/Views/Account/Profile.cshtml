@model ShoeShop.Web.Models.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="row">
    <div class="col-lg-4">
        <div class="card shadow mb-4">
            <div class="card-body text-center">
                <div class="mb-3">
                    <i class="fas fa-user-circle fa-5x text-primary"></i>
                </div>
                <h5 class="card-title">@Model.FirstName @Model.LastName</h5>
                <p class="text-muted">@@Model.Username</p>
                <div class="mb-2">
                    @if (User.IsInRole("Administrator"))
                    {
                        <span class="badge bg-danger fs-6">Administrator</span>
                    }
                    else if (User.IsInRole("Manager"))
                    {
                        <span class="badge bg-warning text-dark fs-6">Manager</span>
                    }
                    else
                    {
                        <span class="badge bg-info fs-6">Employee</span>
                    }
                </div>
                <small class="text-muted">Member since @Model.CreatedDate.ToString("MMMM yyyy")</small>
            </div>
        </div>

        <div class="card shadow">
            <div class="card-header">
                <h6 class="card-title mb-0"><i class="fas fa-chart-line me-2"></i>Account Statistics</h6>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-6">
                        <div class="border-end">
                            <h4 class="text-primary">@Model.LoginCount</h4>
                            <small class="text-muted">Total Logins</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <h4 class="text-success">@Model.DaysActive</h4>
                        <small class="text-muted">Days Active</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Personal Information -->
        <div class="card shadow mb-4">
            <div class="card-header">
                <h6 class="card-title mb-0"><i class="fas fa-user me-2"></i>Personal Information</h6>
            </div>
            <div class="card-body">
                <form asp-action="UpdateProfile" method="post">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="FirstName" class="form-label">First Name</label>
                                <input asp-for="FirstName" class="form-control" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="LastName" class="form-label">Last Name</label>
                                <input asp-for="LastName" class="form-control" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email Address</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label">Username</label>
                        <input asp-for="Username" class="form-control" readonly />
                        <div class="form-text">Username cannot be changed after registration.</div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>Update Profile
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Change Password -->
        <div class="card shadow">
            <div class="card-header">
                <h6 class="card-title mb-0"><i class="fas fa-key me-2"></i>Change Password</h6>
            </div>
            <div class="card-body">
                <form asp-action="ChangePassword" method="post">
                    <div class="mb-3">
                        <label for="currentPassword" class="form-label">Current Password</label>
                        <input type="password" id="currentPassword" name="CurrentPassword" class="form-control" required />
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="newPassword" class="form-label">New Password</label>
                                <input type="password" id="newPassword" name="NewPassword" class="form-control" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="confirmPassword" class="form-label">Confirm New Password</label>
                                <input type="password" id="confirmPassword" name="ConfirmPassword" class="form-control" required />
                            </div>
                        </div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-warning">
                            <i class="fas fa-key me-2"></i>Change Password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}